# Copie para .env e preencha com os valores reais. Nunca commitar o .env preenchido.

DATABASE_URL=postgres://usuario:senha@host:porta/banco

JWT_SECRET=defina-um-segredo-forte-aqui

# Obrigatório em produção (Aiven/Render): conteúdo do certificado da CA usado
# para validar a conexão SSL com o Postgres (substitui rejectUnauthorized: false).
# Pode ser colado como PEM multi-linha ou com \n escapado em uma linha só.
DB_CA_CERT=

# Lista de origens autorizadas a chamar a API, separadas por vírgula.
# Ex.: https://app.monipro.com,https://staging.monipro.com
ALLOWED_ORIGINS=
