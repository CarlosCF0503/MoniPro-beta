# Copie para .env e preencha com os valores reais. Nunca commitar o .env preenchido.

# Postgres no Docker: o host e sempre "db" (nome do servico no docker-compose.yml).
# Formato: postgres://USUARIO:SENHA@db:5432/BANCO
# A SENHA aqui tem que ser a mesma de POSTGRES_PASSWORD abaixo.
DATABASE_URL=postgres://monipro:TROCAR_SENHA@db:5432/db_monipro

# NAO adicionar "?sslmode=require" aqui: o driver pg trata isso como alias de
# verify-full e monta sua propria validacao com o repositorio de CAs do sistema,
# ignorando o DB_CA_CERT abaixo -- toda query falha com "self-signed certificate
# in certificate chain". A validacao SSL ja e feita explicitamente pelo codigo.

JWT_SECRET=defina-um-segredo-forte-aqui

# Obrigatorio em producao: conteudo da CA (certs/ca.crt) que assinou o certificado
# do Postgres, em UMA linha, com \n escapado e SEM aspas.
# Gerar: awk 'NF {printf "%s\\n", $0}' certs/ca.crt
# A pasta certs/ nao e versionada: ca.crt, server.crt e server.key sao gerados no
# servidor com openssl (CN=db, SAN db e localhost) e o server.key pertence ao uid 999.
DB_CA_CERT=

# Variaveis do container Postgres (docker-compose.yml)
POSTGRES_VERSION=17
POSTGRES_USER=monipro
POSTGRES_DB=db_monipro
POSTGRES_PASSWORD=

# Porta do banco no host, sempre em 127.0.0.1 (acesso por tunel SSH, ex.: DBeaver).
# Producao usa 5432; o develop usa 5433 para nao colidir.
DB_PORT=5432

# Lista de origens autorizadas a chamar a API, separadas por virgula.
# Ex.: https://app.monipro.com,https://staging.monipro.com
ALLOWED_ORIGINS=

# Portas do backend e do frontend no host (127.0.0.1).
# Producao: 3000/8080. Develop: 3001/8099.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# URL base da API usada pelo frontend (Monipro_web/JS/config.js), injetada no container
# Nginx no arranque via docker-compose.yml. Opcional — padrão: https://moni-pro.app.br
API_BASE_URL=
