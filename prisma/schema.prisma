generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  aluno
  monitor
  // Plano 7 (RN-014): só criado por scripts/criar-coordenador.js, nunca pelo cadastro público
  coordenador
}

enum StatusMonitoria {
  ativa
  pendente
  realizada
  concluida
  cancelada
}

// Plano 11 (RF-016): a vaga é presencial (com local) ou on-line (com link da sala)
enum Modalidade {
  presencial
  online
}

enum StatusAgendamento {
  pendente
  confirmado
  concluido
  cancelado
  // Plano 8 (RF-013): na lista de espera de uma vaga lotada. Não ocupa lugar; a posição é a
  // ordem de entrada (id)
  em_espera
}

model Usuario {
  id            Int          @id @default(autoincrement())
  nome_completo String
  email         String
  senha         String
  tipo_usuario  TipoUsuario
  matricula     Int
  pontos        Int          @default(0) // <-- CAMPO DE GAMIFICAÇÃO
  versao_token  Int          @default(0) // P3 (R7): o "sair" incrementa e revoga os JWT emitidos antes
  // R3 (LGPD): o último login conta o prazo de retenção de contas paradas; a conta excluída
  // (ou parada além do prazo) é anonimizada, e anonimizado_em guarda quando
  ultimo_acesso  DateTime?   @default(now())
  anonimizado_em DateTime?
  // Plano 14 (RF-018, RN-017): null = e-mail ainda não confirmado (login bloqueado). criado_em
  // conta o prazo da conta pendente, apagada pela retenção se ninguém confirmar
  criado_em           DateTime  @default(now())
  email_confirmado_em DateTime?

  monitorias_criadas Monitoria[]   @relation("MonitorParaMonitoria")
  meus_agendamentos  Agendamento[] @relation("AlunoParaAgendamento")
  tokens_redefinicao TokenRedefinicao[]
  tokens_confirmacao TokenConfirmacaoEmail[]
  notificacoes       Notificacao[]
  eventos_pontuacao  EventoPontuacao[]
  certificados       Certificado[]
  auditoria          Auditoria[]

  @@unique([email, tipo_usuario])
  @@unique([matricula, tipo_usuario])
  @@map("usuarios")
}

// Plano 7: a disciplina criada por monitor fica pendente até a coordenação aprovar ou mesclar
enum StatusDisciplina {
  pendente
  aprovada
}

model Disciplina {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  monitorias Monitoria[]
  eventos_pontuacao EventoPontuacao[]
  // Plano 7: pendente só aparece para quem criou e para a coordenação. As que já existiam
  // ficam aprovadas
  status     StatusDisciplina @default(aprovada)
  id_criador Int?
  criada_em  DateTime    @default(now())

  @@index([status])
  @@map("disciplinas")
}

model Monitoria {
  id            Int             @id @default(autoincrement())
  horario       DateTime
  data_fim      DateTime?       // preenchida pelo monitor ao finalizar (status -> realizada)
  descricao     String?
  local         String
  status        StatusMonitoria @default(ativa)
  capacidade    Int             @default(1) // nº máximo de alunos inscritos simultaneamente na vaga
  // Plano 11: on-line tem link (só para inscritos, nunca na listagem) e local "On-line"
  modalidade    Modalidade      @default(presencial)
  link          String?
  // Plano 9: uuid compartilhado pelas vagas criadas juntas, toda semana (null = vaga avulsa)
  id_serie      String?

  id_monitor    Int
  monitor       Usuario         @relation("MonitorParaMonitoria", fields: [id_monitor], references: [id])

  id_disciplina Int
  disciplina    Disciplina      @relation(fields: [id_disciplina], references: [id])

  inscricoes    Agendamento[]

  @@index([id_monitor])
  @@index([id_disciplina])
  @@index([id_serie])
  @@map("monitorias")
}

model Agendamento {
  id           Int               @id @default(autoincrement())
  data_hora    DateTime
  status       StatusAgendamento @default(pendente)
  // P2 (R4): a presença vale quando os dois confirmam; aí o status vira concluido
  presenca_aluno_em   DateTime?
  presenca_monitor_em DateTime?
  // Editar vaga: preenchido quando a vaga muda de dia, horário ou local. A partir daí o aluno
  // pode cancelar sem a antecedência de 24h da RN-001 (até o início)
  liberado_cancelar_em DateTime?
  // Como a vaga era quando o aluno se inscreveu (só o que mudou), para o perfil mostrar o antes
  horario_anterior     DateTime?
  local_anterior       String?
  // Plano 8: quando saiu da lista de espera e virou inscrição (RN-015)
  promovido_em         DateTime?
  // Plano 12 (RN-016): o monitor marcou que o aluno faltou. Exclui a presença do monitor;
  // apagado pela retenção depois de 180 dias (LGPD)
  ausente_em           DateTime?
  // Plano 7: pedido de revisão da falta (recurso), um por inscrição
  recurso              RecursoFalta?
  // Plano 6 (RF-006): a avaliação que o aluno deu a esta monitoria, uma por inscrição
  avaliacao            Avaliacao?

  id_monitoria Int
  monitoria    Monitoria         @relation(fields: [id_monitoria], references: [id])

  id_aluno     Int
  aluno        Usuario           @relation("AlunoParaAgendamento", fields: [id_aluno], references: [id])

  @@index([id_monitoria])
  @@index([id_aluno])
  @@index([id_monitoria, status, id])
  @@index([id_aluno, ausente_em])
  @@map("agendamentos")
}

// RF-008 / RN-009 (recuperar senha): o link de redefinição vale 30 minutos e uma única vez.
// Só o hash SHA-256 do token fica no banco; o token puro existe apenas no e-mail enviado.
model TokenRedefinicao {
  id         Int       @id @default(autoincrement())
  id_usuario Int
  usuario    Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  hash       String    @unique
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())

  @@index([id_usuario])
  @@map("tokens_redefinicao")
}

// Plano 14 (RF-018, RN-017): tokens do link de confirmação do e-mail, guardados só como hash
model TokenConfirmacaoEmail {
  id         Int       @id @default(autoincrement())
  id_usuario Int
  usuario    Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  hash       String    @unique
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())

  @@index([id_usuario])
  @@map("tokens_confirmacao_email")
}

// Plano 3 (RF-010, RN-011): fila de e-mails de aviso. A ação (inscrição, edição, cancelamento)
// grava a notificação na mesma transação; o backend envia depois, com novas tentativas.
enum StatusNotificacao {
  pendente
  enviada
  falhou
}

model Notificacao {
  id          Int               @id @default(autoincrement())
  id_usuario  Int
  usuario     Usuario           @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  modelo      String            // inscricao | lembrete | vaga-alterada | vaga-cancelada
  dados       Json              // só o que o modelo precisa (disciplina, horário, local...)
  chave       String            @unique // evita o mesmo aviso duas vezes (ex.: lembrete:agendamento:108:<horário>)
  status      StatusNotificacao @default(pendente)
  tentativas  Int               @default(0)
  ultimo_erro String?
  enviar_apos DateTime          @default(now())
  enviada_em  DateTime?
  criado_em   DateTime          @default(now())

  @@index([status, enviar_apos])
  @@index([id_usuario])
  @@map("notificacoes")
}

// Plano 5 (RN-008 revisada, RF-011): cada ganho de pontos vira um evento com disciplina, motivo e
// semestre. Usuario.pontos continua como saldo pronto (cache), atualizado na mesma transação.
enum TipoEventoPontuacao {
  presenca_aluno
  sessao_monitor
  saldo_inicial
  estorno
}

model EventoPontuacao {
  id             Int                 @id @default(autoincrement())
  id_usuario     Int
  usuario        Usuario             @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  tipo           TipoEventoPontuacao
  pontos         Int
  id_disciplina  Int?
  disciplina     Disciplina?         @relation(fields: [id_disciplina], references: [id], onDelete: SetNull)
  id_agendamento Int?                // origem do ponto; sem chave estrangeira, porque a retenção apaga inscrições antigas
  periodo        String              // semestre: "2026.1" (jan–jun) ou "2026.2" (jul–dez)
  chave          String              @unique // ex.: "presenca_aluno:agendamento:42" (o mesmo ponto nunca entra duas vezes)
  criado_em      DateTime            @default(now())

  @@index([id_usuario])
  @@index([id_disciplina, periodo])
  @@map("eventos_pontuacao")
}

// Certificados (RF-005): declaração de horas do monitor, uma válida por semestre. O snapshot
// congela nome, horas e sessões na emissão: o documento não muda depois.
enum SituacaoCertificado {
  valido
  substituido
  revogado
}

model Certificado {
  id               Int                 @id @default(autoincrement())
  codigo           String              @unique // 128 bits aleatórios em base32; nunca o id
  id_usuario       Int
  usuario          Usuario             @relation(fields: [id_usuario], references: [id])
  periodo          String              // "2026.2"
  carga_minutos    Int
  snapshot         Json
  situacao         SituacaoCertificado @default(valido)
  emitido_em       DateTime            @default(now())
  revogado_em      DateTime?
  motivo_revogacao String?
  // Plano 7: assinatura da coordenação (null = só "emitida pela plataforma"). O nome fica
  // guardado como estava ao assinar, como o snapshot; id_assinante é só referência (a ação
  // também fica na auditoria)
  assinado_em      DateTime?
  id_assinante     Int?
  assinante_nome   String?

  @@index([id_usuario, periodo])
  @@index([situacao, assinado_em])
  @@map("certificados")
}

// Plano 7 (RN-014): cada ação de escrita do painel da coordenação, com quem e quando. Guarda só
// ids e um resumo; o painel não apaga nem edita linhas.
model Auditoria {
  id         Int      @id @default(autoincrement())
  id_usuario Int
  usuario    Usuario  @relation(fields: [id_usuario], references: [id])
  acao       String   @db.VarChar(40) // criar_coordenador | assinar_certificado | revogar_certificado | aprovar_disciplina | mesclar_disciplina | marcar_falta | anular_falta | aceitar_recurso | recusar_recurso | ocultar_avaliacao | reexibir_avaliacao
  alvo       String   @db.VarChar(60) // "certificado:12", "disciplina:5"
  descricao  String   @db.VarChar(300)
  criado_em  DateTime @default(now())

  @@index([criado_em])
  @@map("auditoria")
}

// Plano 7: o aluno pede revisão da falta com um comprovante (atestado). Dado de saúde (LGPD,
// art. 11): só a coordenação baixa o arquivo, e a rotina de retenção apaga o pedido 180 dias
// depois do envio. Sai junto com a inscrição (cascade) e com a exclusão da conta do aluno.
enum StatusRecurso {
  pendente
  aceito
  recusado
}

model RecursoFalta {
  id              Int           @id @default(autoincrement())
  id_agendamento  Int           @unique
  agendamento     Agendamento   @relation(fields: [id_agendamento], references: [id], onDelete: Cascade)
  id_aluno        Int
  justificativa   String        @db.VarChar(500)
  arquivo_nome    String        @db.VarChar(120)
  arquivo_tipo    String        @db.VarChar(30)
  arquivo_tamanho Int
  arquivo         Bytes
  status          StatusRecurso @default(pendente)
  motivo_decisao  String?       @db.VarChar(300)
  id_decisor      Int?
  criado_em       DateTime      @default(now())
  decidido_em     DateTime?

  @@index([status])
  @@index([id_aluno])
  @@index([criado_em])
  @@map("recursos_falta")
}

// Plano 6 (RF-006/007, RN-013): o aluno com presença dos dois lados avalia a monitoria (1 a 5,
// comentário opcional), uma vez, até 7 dias depois. O monitor vê sem o nome do aluno; a
// coordenação oculta comentário ofensivo ou pessoal, e a nota oculta sai da média (22/11).
model Avaliacao {
  id             Int         @id @default(autoincrement())
  id_agendamento Int         @unique
  agendamento    Agendamento @relation(fields: [id_agendamento], references: [id], onDelete: Cascade)
  id_aluno       Int
  id_monitor     Int         // desnormalizado para o resumo do monitor
  nota           Int         // 1 a 5 (check na migração)
  comentario     String?     @db.VarChar(300)
  oculto_em      DateTime?
  id_moderador   Int?
  criado_em      DateTime    @default(now())

  @@index([id_monitor, oculto_em])
  @@index([criado_em])
  @@index([id_aluno])
  @@map("avaliacoes")
}
