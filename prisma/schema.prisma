generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  aluno
  monitor
}

enum StatusMonitoria {
  ativa
  pendente
  realizada
  concluida
  cancelada
}

enum StatusAgendamento {
  pendente
  confirmado
  concluido
  cancelado
}

model Usuario {
  id            Int          @id @default(autoincrement())
  nome_completo String
  email         String
  senha         String
  tipo_usuario  TipoUsuario
  matricula     Int
  pontos        Int          @default(0) // <-- CAMPO DE GAMIFICAÇÃO
  versao_token  Int          @default(0) // P3 (R7): o "sair" incrementa e revoga os JWT emitidos antes
  // R3 (LGPD): o último login conta o prazo de retenção de contas paradas; a conta excluída
  // (ou parada além do prazo) é anonimizada, e anonimizado_em guarda quando
  ultimo_acesso  DateTime?   @default(now())
  anonimizado_em DateTime?
  // Plano 14 (RF-018, RN-017): null = e-mail ainda não confirmado (login bloqueado). criado_em
  // conta o prazo da conta pendente, apagada pela retenção se ninguém confirmar
  criado_em           DateTime  @default(now())
  email_confirmado_em DateTime?

  monitorias_criadas Monitoria[]   @relation("MonitorParaMonitoria")
  meus_agendamentos  Agendamento[] @relation("AlunoParaAgendamento")
  tokens_redefinicao TokenRedefinicao[]
  tokens_confirmacao TokenConfirmacaoEmail[]
  notificacoes       Notificacao[]

  @@unique([email, tipo_usuario])
  @@unique([matricula, tipo_usuario])
  @@map("usuarios")
}

model Disciplina {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  monitorias Monitoria[]

  @@map("disciplinas")
}

model Monitoria {
  id            Int             @id @default(autoincrement())
  horario       DateTime
  data_fim      DateTime?       // preenchida pelo monitor ao finalizar (status -> realizada)
  descricao     String?
  local         String
  status        StatusMonitoria @default(ativa)
  capacidade    Int             @default(1) // nº máximo de alunos inscritos simultaneamente na vaga

  id_monitor    Int
  monitor       Usuario         @relation("MonitorParaMonitoria", fields: [id_monitor], references: [id])

  id_disciplina Int
  disciplina    Disciplina      @relation(fields: [id_disciplina], references: [id])

  inscricoes    Agendamento[]

  @@index([id_monitor])
  @@index([id_disciplina])
  @@map("monitorias")
}

model Agendamento {
  id           Int               @id @default(autoincrement())
  data_hora    DateTime
  status       StatusAgendamento @default(pendente)
  // P2 (R4): a presença vale quando os dois confirmam; aí o status vira concluido
  presenca_aluno_em   DateTime?
  presenca_monitor_em DateTime?
  // Editar vaga: preenchido quando a vaga muda de dia, horário ou local. A partir daí o aluno
  // pode cancelar sem a antecedência de 24h da RN-001 (até o início)
  liberado_cancelar_em DateTime?
  // Como a vaga era quando o aluno se inscreveu (só o que mudou), para o perfil mostrar o antes
  horario_anterior     DateTime?
  local_anterior       String?

  id_monitoria Int
  monitoria    Monitoria         @relation(fields: [id_monitoria], references: [id])

  id_aluno     Int
  aluno        Usuario           @relation("AlunoParaAgendamento", fields: [id_aluno], references: [id])

  @@index([id_monitoria])
  @@index([id_aluno])
  @@map("agendamentos")
}

// RF-008 / RN-009 (recuperar senha): o link de redefinição vale 30 minutos e uma única vez.
// Só o hash SHA-256 do token fica no banco; o token puro existe apenas no e-mail enviado.
model TokenRedefinicao {
  id         Int       @id @default(autoincrement())
  id_usuario Int
  usuario    Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  hash       String    @unique
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())

  @@index([id_usuario])
  @@map("tokens_redefinicao")
}

// Plano 14 (RF-018, RN-017): tokens do link de confirmação do e-mail, guardados só como hash
model TokenConfirmacaoEmail {
  id         Int       @id @default(autoincrement())
  id_usuario Int
  usuario    Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  hash       String    @unique
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())

  @@index([id_usuario])
  @@map("tokens_confirmacao_email")
}

// Plano 3 (RF-010, RN-011): fila de e-mails de aviso. A ação (inscrição, edição, cancelamento)
// grava a notificação na mesma transação; o backend envia depois, com novas tentativas.
enum StatusNotificacao {
  pendente
  enviada
  falhou
}

model Notificacao {
  id          Int               @id @default(autoincrement())
  id_usuario  Int
  usuario     Usuario           @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  modelo      String            // inscricao | lembrete | vaga-alterada | vaga-cancelada
  dados       Json              // só o que o modelo precisa (disciplina, horário, local...)
  chave       String            @unique // evita o mesmo aviso duas vezes (ex.: lembrete:agendamento:108:<horário>)
  status      StatusNotificacao @default(pendente)
  tentativas  Int               @default(0)
  ultimo_erro String?
  enviar_apos DateTime          @default(now())
  enviada_em  DateTime?
  criado_em   DateTime          @default(now())

  @@index([status, enviar_apos])
  @@index([id_usuario])
  @@map("notificacoes")
}
